# Copier ce fichier en .env puis adapter les valeurs. Ne jamais versionner .env.

# --- Stack ELK ---
STACK_VERSION=8.13.4
ELASTICSEARCH_URL=http://elasticsearch:9200

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_URI=mongodb://admin:changeme@mongo:27017/?authSource=admin
MONGO_DB=saas_logs

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Application Flask ---
SECRET_KEY=change-me-en-production
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=100
LOG_LEVEL=INFO
